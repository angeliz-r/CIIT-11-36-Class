<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ButtonStyle.uss?fileID=7433441132597879392&amp;guid=100c1bf942cb0ab418aaa3c94383dfb7&amp;type=3#ButtonStyle" />
    <engine:VisualElement name="Panel" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/2D%20Assets/UI%20Assets/BG.png?fileID=2800000&amp;guid=b7dfc934ab3dccc4d85bf0097fd479a9&amp;type=3#BG&quot;); background-color: rgb(255, 255, 255); -unity-background-image-tint-color: rgb(120, 120, 120);">
        <engine:Label text="ALIEN EXPLORER" name="Title" style="-unity-font-style: normal; font-size: 169px; align-items: center; justify-content: center; align-self: center; padding-top: 50px; padding-bottom: 50px; padding-right: 10px; padding-left: 10px; -unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(2, 164, 159); text-shadow: 0 0 0 rgba(0, 0, 0, 0.89);" />
        <engine:Button text="New Game&#10;" name="NewGame" class="Button" style="max-width: none; position: relative;" />
        <engine:Button text="Continue" name="Continue" class="Button" />
        <engine:Button text="Exit&#10;" name="Exit" class="Button" />
        <engine:Button text="OPtions&#10;" name="Options" enabled="false" class="Button" style="display: none;" />
        <engine:Label name="Status" style="-unity-font-style: bold; font-size: 30px; align-items: center; justify-content: center; align-self: center; padding-top: 50px; padding-bottom: 50px; padding-right: 10px; padding-left: 10px; visibility: visible; color: rgb(255, 255, 255);" />
    </engine:VisualElement>
</engine:UXML>
