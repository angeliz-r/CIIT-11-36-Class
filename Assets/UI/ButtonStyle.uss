Button {
    background-image: url("project://database/Assets/2D%20Assets/UI%20Assets/blue_button02.png?fileID=2800000&guid=6de070e7e4f6136448badae1ad512a28&type=3#blue_button02");
    -unity-font-definition: url("project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&guid=585188cdc4600544eb408bee749e4b3a&type=3#ThaleahFat_TTF");
    font-size: 50px;
    color: rgb(255, 255, 255);
    align-items: stretch;
    justify-content: space-between;
    align-content: flex-start;
    align-self: center;
    width: 26%;
    height: 10%;
    margin-top: 20px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: stretch-to-fill;
    background-size: 100% 100%;
    margin-bottom: 20px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
}

Button:hover {
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/2D%20Assets/UI%20Assets/blue_button13.png?fileID=2800000&guid=bf81b71abb0545f4bbcc6942158cdba9&type=3#blue_button13");
    -unity-font-definition: url("project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&guid=585188cdc4600544eb408bee749e4b3a&type=3#ThaleahFat_TTF");
    font-size: 60px;
    background-size: 100% 100%;
    -unity-font-style: bold;
    align-content: flex-start;
    transition-property: scale;
    transition-timing-function: ease-in-out;
    transition-duration: 0.3s;
    transition-delay: 0.2s;
    color: rgb(60, 185, 181);
}

.unity-slider {
    margin-bottom: 34px;
    margin-top: 13px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 40px;
    background-image: none;
}
