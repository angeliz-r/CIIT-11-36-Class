    <engine:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/2D%20Assets/UI%20Assets/BG.png?fileID=2800000&amp;guid=b7dfc934ab3dccc4d85bf0097fd479a9&amp;type=3#BG&quot;); -unity-background-image-tint-color: rgb(63, 63, 63);">
        <engine:Label text="You Win!" name="WinStatus" style="align-self: center; align-items: center; -unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); font-size: 161px; color: rgb(255, 255, 255);" />
