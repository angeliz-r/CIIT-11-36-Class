.unity-button {
    -unity-font-style: bold;
    background-position-x: center 0;
    background-position-y: top 0;
    -unity-background-scale-mode: scale-to-fit;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: auto;
    height: 50px;
    background-image: url("project://database/Assets/2D%20Assets/UI%20Assets/blue_button02.png?fileID=2800000&guid=6de070e7e4f6136448badae1ad512a28&type=3#blue_button02");
    background-color: rgba(0, 0, 0, 0);
    align-items: flex-start;
    align-content: flex-start;
    justify-content: flex-start;
    align-self: flex-start;
    -unity-font-definition: url("project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&guid=585188cdc4600544eb408bee749e4b3a&type=3#ThaleahFat_TTF");
    font-size: 30px;
    color: rgb(255, 255, 255);
}

.unity-button:hover {
    -unity-font-definition: url("project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&guid=585188cdc4600544eb408bee749e4b3a&type=3#ThaleahFat_TTF");
    -unity-font-style: bold;
    font-size: 30px;
    background-image: url("project://database/Assets/2D%20Assets/UI%20Assets/blue_button02.png?fileID=2800000&guid=6de070e7e4f6136448badae1ad512a28&type=3#blue_button02");
    -unity-background-image-tint-color: rgb(91, 91, 91);
    background-size: contain;
    background-position-y: top 0;
    -unity-background-scale-mode: scale-to-fit;
    color: rgb(255, 255, 255);
}
